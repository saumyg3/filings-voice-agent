# From the SignalWire dashboard -> API
SIGNALWIRE_PROJECT_ID=paste-project-id
SIGNALWIRE_API_TOKEN=paste-api-token
SIGNALWIRE_SPACE=saumyag.signalwire.com

# Your public GitHub repo (owner/name). Datasphere downloads the filings from here.
GITHUB_REPO=saumyg3/filings-voice-agent

# Password SignalWire uses when it calls your agent. Make up anything.
SWML_BASIC_AUTH_USER=agent
SWML_BASIC_AUTH_PASSWORD=pick-something-long

# Your ngrok https URL. Only needed to take phone calls.
SWML_PROXY_URL_BASE=
